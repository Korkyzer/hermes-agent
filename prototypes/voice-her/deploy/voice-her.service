[Unit]
Description=Voice Her prototype
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=multica
WorkingDirectory=/opt/hermes-agent/prototypes/voice-her
EnvironmentFile=/opt/hermes-agent/prototypes/voice-her/.env
ExecStart=/opt/hermes-agent/prototypes/voice-her/.venv/bin/python -m app.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
