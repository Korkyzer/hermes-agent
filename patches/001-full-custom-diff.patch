+        if len(safe_path) > 80:
+            safe_path = "..." + safe_path[-77:]
+        return f"{parts.scheme}://{parts.netloc}{safe_path}"
+    except Exception:
+        return "[invalid-url]"
+
+
+def _reference_cache_dir() -> Path:
