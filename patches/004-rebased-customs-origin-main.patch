+    if status == 429:
+        return True
+    if status in (500, 502, 503, 504):
+        if any(kw in err_lower for kw in (
+            "overloaded", "capacity", "temporarily unavailable",
+            "rate limit", "quota exceeded", "resource exhausted",
+            "too many requests", "try again later",
+        )):
